# Copy to .env.local (local dev) or set these as runtime env vars in your host.
# Never commit real values.

# REQUIRED. Admin login passphrase. Use a long random string (e.g. 4+ random words or 32+ chars).
ADMIN_PASSWORD=

# REQUIRED. Authenticator (TOTP) secret — admin login always needs password + 6-digit code.
# Generate with: npm run totp:setup   (scan the QR code with Google Authenticator / Authy / 1Password)
ADMIN_TOTP_SECRET=

# REQUIRED. Signs admin session cookies (HS256). Must be at least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# OPTIONAL but recommended. Fine-grained GitHub PAT, server-side only, never sent to the browser.
# Create at https://github.com/settings/personal-access-tokens/new
#   Repository access: "Only select repositories" (pick the app repos)
#   Permissions: Contents = Read-only, Metadata = Read-only
# Needed for private repos and for a much higher API rate limit.
GITHUB_TOKEN=

# OPTIONAL. Shared secret for the GitHub "Releases" webhook (/api/webhooks/github).
# Without it the webhook endpoint returns 404; polling sync still works.
GITHUB_WEBHOOK_SECRET=

# Database. Default is a local SQLite file (created automatically; schema migrates on boot).
DATABASE_URL=file:./data/appdrop.db
# Turso / libSQL instead (Vercel-friendly). Use the libsql:// URL and a token:
# DATABASE_URL=libsql://your-db-name-your-org.turso.io
# DATABASE_AUTH_TOKEN=

# Shown in the store header, the web app manifest and the install prompt. Defaults to "AppDrop".
NEXT_PUBLIC_SITE_NAME=AppDrop

# Minutes before a repo's release list is considered stale and refreshed in the background.
SYNC_TTL_MINUTES=15

# OPTIONAL. Bearer key for the publishing API (/api/v1) used by the AppDrop CLI / Claude Code skill.
# At least 32 characters; leave empty to disable the API entirely (it then returns 404).
# Generate with: openssl rand -hex 32
APPDROP_API_KEY=

# Public URL of the store (no trailing slash). Used for beta invite links, update-check endpoints,
# share links and page metadata. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OPTIONAL. Owner name shown on the store ("Apps by ...") and in share text. Unset = the default in src/lib/brand.ts.
NEXT_PUBLIC_OWNER_NAME=

# OPTIONAL. Web Push (new-release notifications). Push is disabled unless both keys are set.
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service, as mailto: or https:. Defaults to mailto:admin@example.com.
VAPID_SUBJECT=mailto:you@example.com

# OPTIONAL. Bearer token for the scheduled database backup endpoint (GET /api/backup).
# Backups are disabled (404) unless set. Generate with: openssl rand -hex 32
# Also add the same value as the GitHub repo secret APPDROP_BACKUP_TOKEN.
BACKUP_TOKEN=
